#ifndef VERSION_H
#define VERSION_H

#ifndef APP_VERSION
#define APP_VERSION "@CMAKE_PROJECT_VERSION@"
#endif

#ifndef APP_MAJOR_VERSION
#define APP_MAJOR_VERSION "@APP_MAJOR_VERSION@"
#endif

#define APPLICATION_NAME    "AmneziaVPN"
#define SERVICE_NAME        "AmneziaVPN-service"
#define ORGANIZATION_NAME   "AmneziaVPN.ORG"

// User-facing brand name of the fork. Kept separate from APPLICATION_NAME so
// the QSettings/keychain storage path (tied to APPLICATION_NAME) stays stable
// and existing profiles are preserved. A full org/app rename is a later
// release step that requires data migration.
#define DISPLAY_NAME        "DEVKZ VPN"

#endif  // VERSION_H
